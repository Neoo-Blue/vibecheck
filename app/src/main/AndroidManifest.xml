<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The optional buzz on a high-risk message. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Only to mark which of the known chat apps are installed in settings. -->
    <queries>
        <package android:name="com.tencent.mm" />
        <package android:name="cn.soulapp.android" />
        <package android:name="com.facebook.orca" />
        <package android:name="com.google.android.apps.messaging" />
        <package android:name="com.samsung.android.messaging" />
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="org.telegram.messenger" />
        <package android:name="com.instagram.android" />
        <package android:name="jp.naver.line.android" />
        <package android:name="org.thoughtcrime.securesms" />
        <package android:name="com.snapchat.android" />
        <package android:name="com.tencent.mobileqq" />
        <package android:name="com.kakao.talk" />
        <package android:name="com.viber.voip" />
        <package android:name="com.twitter.android" />
        <package android:name="com.microsoft.teams" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Ask Play Services to fetch the Chinese OCR model at install time. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr_chinese" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".ChatReaderService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
